# ---- Telegram MTProto credentials (REQUIRED) -------------------------------
# Get these from https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=your_api_hash_here

# Telethon session name (a file named <SESSION_NAME>.session will be created)
SESSION_NAME=media_processor
# Directory where the session file is stored (persist this across deployments)
SESSION_DIR=./data/sessions

# ---- Optional convenience (leave empty for interactive prompts) -------------
# Phone number in international format, e.g. +15551234567
TELEGRAM_PHONE=
# Restrict processing to this Telegram user id (must be your own account id)
OWNER_ID=

# ---- Storage paths ----------------------------------------------------------
DOWNLOAD_DIR=./data/downloads
JOB_DIR=./data/jobs
LOG_DIR=./data/logs

# ---- Limits -----------------------------------------------------------------
MAX_ARCHIVE_SIZE_MB=500
MAX_EXTRACTED_SIZE_MB=2000
MAX_FILES_PER_ARCHIVE=10000

# ---- Behaviour --------------------------------------------------------------
# true  -> keep archive/ and extracted/ after a job finishes (debugging)
# false -> delete them after a successful scan (metadata.json is always kept)
KEEP_JOB_FILES=false
WORKER_COUNT=1

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
