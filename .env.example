# ---- Telegram MTProto credentials (REQUIRED) -------------------------------
# Get these from https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=your_api_hash_here


# ---- Telegram Login Bot ---------------------------------------------------
# Create a bot using @BotFather and put its token here.
BOT_TOKEN=

# Your own numeric Telegram user ID.
# Only this Telegram account will be allowed to use /login.
BOT_OWNER_ID=


# ---- Persistent Telegram session (MongoDB) ---------------------------------
# The userbot StringSession is stored here, so redeploys keep the login.
# Leave MONGODB_URI empty to use a local session file instead.
MONGODB_URI=
MONGODB_DATABASE=telegram_media_processor
MONGODB_COLLECTION=sessions


# ---- Telethon userbot session ----------------------------------------------
# The userbot session is created after QR login.
SESSION_NAME=media_processor

# IMPORTANT:
# On Koyeb use /data/sessions and persist /data with a Volume.
SESSION_DIR=./data/sessions


# ---- Legacy owner restriction ---------------------------------------------
# Optional. The authenticated Telegram account ID is automatically detected
# after QR login.
OWNER_ID=

# No phone/OTP login is used anymore.
TELEGRAM_PHONE=


# ---- Storage paths ----------------------------------------------------------
DOWNLOAD_DIR=./data/downloads
JOB_DIR=./data/jobs
LOG_DIR=./data/logs


# ---- Limits -----------------------------------------------------------------
MAX_ARCHIVE_SIZE_MB=500
MAX_EXTRACTED_SIZE_MB=2000
MAX_FILES_PER_ARCHIVE=10000


# ---- Behaviour --------------------------------------------------------------
# true  -> keep archive/ and extracted/ after a job finishes
# false -> delete them after a successful scan
KEEP_JOB_FILES=false

WORKER_COUNT=1


# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5


# ---- Images: ImgBB + Telegraph ------------------------------------------------
# Images <= 2 MiB are uploaded to ImgBB; larger images are skipped (with a reason).
# ONE Telegraph article is then built from the ImgBB image URLs.
# Videos NEVER go to ImgBB or Telegraph.
IMGBB_API_KEY=

# Optional. Without it an anonymous Telegraph account is created on every start.
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=


# ---- Videos: Telegram uploader bots -------------------------------------------
# Videos are sent, ONE AT A TIME, to these bots (tried in this order). The URL is
# taken from the bot's reply / edited reply to that exact video:
#   @DiskWalaFileUploaderBot -> https://www.diskwala.com/app/...
#   @FlezenUploadBot         -> https://flezen.com/s/...   (slow: the first
#     "Downloading the file, please wait..." message is NOT a result; the bot is
#     watched until the final URL appears)
VIDEO_BOTS=@DiskWalaFileUploaderBot,@FlezenUploadBot

# Seconds to wait for the final URL AFTER the video was delivered to a bot (10-7200).
VIDEO_BOT_TIMEOUT_SECONDS=1800

# Attempts to DELIVER one video to a bot (1-5). A video is never re-sent while a
# bot may still be processing it.
VIDEO_BOT_SEND_ATTEMPTS=2

# Per-video limit in GB. Larger videos are not sent and are reported as failed.
VIDEO_MAX_SIZE_GB=1.5

# Advanced (defaults shown). Only set these if you know you need them.
# true -> after a timeout also try the next bot (may create a duplicate upload)
VIDEO_BOT_FALLBACK_ON_TIMEOUT=false
# true -> only accept bot messages that reply to the video that was sent
VIDEO_BOT_REQUIRE_REPLY=true
# Extra regex for an additional link format (DiskWala/Flezen are built in).
# VIDEO_URL_PATTERN=
