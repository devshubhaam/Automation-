# ---- Telegram MTProto credentials (REQUIRED) -------------------------------
# Get these from https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=your_api_hash_here


# ---- Telegram Login Bot ---------------------------------------------------
# Create a bot using @BotFather and put its token here.
BOT_TOKEN=

# Your own numeric Telegram user ID.
# Only this Telegram account will be allowed to use /login.
BOT_OWNER_ID=


# ---- Telethon userbot session ----------------------------------------------
# The userbot session is created after QR login.
SESSION_NAME=media_processor

# IMPORTANT:
# On Koyeb use /data/sessions and persist /data with a Volume.
SESSION_DIR=./data/sessions


# ---- Legacy owner restriction ---------------------------------------------
# Optional. The authenticated Telegram account ID is automatically detected
# after QR login.
OWNER_ID=

# No phone/OTP login is used anymore.
TELEGRAM_PHONE=


# ---- Storage paths ----------------------------------------------------------
DOWNLOAD_DIR=./data/downloads
JOB_DIR=./data/jobs
LOG_DIR=./data/logs


# ---- Limits -----------------------------------------------------------------
MAX_ARCHIVE_SIZE_MB=500
MAX_EXTRACTED_SIZE_MB=2000
MAX_FILES_PER_ARCHIVE=10000


# ---- Behaviour --------------------------------------------------------------
# true  -> keep archive/ and extracted/ after a job finishes
# false -> delete them after a successful scan
KEEP_JOB_FILES=false

WORKER_COUNT=1


# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
